# Dependencies
node_modules/
*/node_modules/

# Environment files (NEVER commit these)
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# Keep the example files (safe to commit)
!.env.example
!backend/.env.example
!frontend/.env.example

# Build outputs
build/
dist/
frontend/build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Arduino IDE
firmware/**/build/
*.hex
*.bin

# Misc
.cache/
coverage/